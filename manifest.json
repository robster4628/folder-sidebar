{
  "manifest_version": 3,
  "key": "",
  "name": "Folder Sidebar",
  "version": "1.2.4",
  "description": "Arc-style spaces, pinned grid, nested folders and a media drawer in Chrome's side panel. Saved links are ordinary Chrome bookmarks.",
  "permissions": [
    "sidePanel",
    "bookmarks",
    "tabs",
    "storage",
    "favicon",
    "scripting",
    "identity"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Toggle Folder Sidebar",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Toggle the sidebar"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://accounts.spotify.com/*",
    "https://api.spotify.com/*"
  ],
  "optional_host_permissions": [
    "*://*.youtube.com/*",
    "*://listen.tidal.com/*",
    "*://open.spotify.com/*",
    "*://*.soundcloud.com/*"
  ]
}
