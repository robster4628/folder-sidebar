{
  "manifest_version": 3,
  "name": "Folder Sidebar",
  "version": "1.1.0",
  "description": "Arc-style spaces, pinned grid and nested folders in Chrome's side panel. Everything is stored as ordinary Chrome bookmarks.",
  "permissions": ["sidePanel", "bookmarks", "tabs", "storage", "favicon"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_title": "Toggle Folder Sidebar",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+S", "mac": "Alt+S" },
      "description": "Toggle the sidebar"
    }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
